# Supabase (Project Settings → API Keys). Use the PUBLISHABLE key (sb_publishable_...), NOT the secret key.
# On a hosting platform you can set these as environment variables instead
# (SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY also work). The build stops if a secret key is used here.
VITE_SUPABASE_URL=https://hpodtwxixhchdveuygsk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Where the Node API is hosted (Stripe checkout, certificates, emails)
VITE_API_URL=https://api.kudrathumane.org
